# The stand's config: what a run of this benchmark is made of. Copy this file to stand.env and fill it in. setup.sh builds and
# checks the stand from it; every case's results record it (results/<id>/stand.json). Change a value and you get a different
# benchmark: write the change down before you compare results. A value set in the environment wins over this file
# (JUDGE_MODEL=opus ./bench.sh case c01). A value has no spaces and no "#".

# The git repository your cases come from (required), and the stand's data dir outside it: tools, snapshots, run output.
HOST_REPO=
BENCH_DATA=~/.context-tools-bench
# The arms of a cycle, in order: one adapter per family, arms/<FAMILY>.zsh. An arm's family is its name up to the first "-".
ARMS=BARE,SERENA,GRAPHIFY,TRAIL
# Sessions per arm per case, and sessions at once (each is a Claude Code process: three fit in 16 GB of RAM).
RUNS=2
PAR=3
# Models (Claude Code aliases): the sessions that write the briefs, and the judge. Calibrate a cheaper judge before you
# trust it (calibrate.sh, compare_judges.py).
BRIEF_MODEL=sonnet
JUDGE_MODEL=sonnet
# The tools' pins. setup installs Trail from tools/trail/package-lock.json and checks the others; it never upgrades them.
# Another Claude Code version is a warning, recorded per case.
CLAUDE_VERSION=2.1.301
TRAIL_VERSION=0.23.0
GRAPHIFY_VERSION=0.9.91
SERENA_VERSION=2.0.0
# The case field the agent receives as its task, and the path parts that mark a test file of the change.
REQUEST_FIELD=request_en
TEST_DIRS=__tests__,tests,test
# Which reads count as reading docs in the cost split (a regex on the file's absolute path).
DOCS_RE=(^|/)(CLAUDE|AGENTS|README)\.md$|/docs/.*\.md$
# Removed from every snapshot (globs from the repository root): local settings, and any in-repo copy of a tool under test.
# An ablation adds your docs here and runs into its own dirs: BASE_STRIP=… BENCH=… RESULTS=… ./bench.sh case <id>
BASE_STRIP=.claude/settings.local.json*
# Host files whose long lines must never show in a session unless the snapshot has them (the leak audit).
LEAK_PROBE_FILES=CLAUDE.md
# The summary of one case.
SUMMARY=summary.py
